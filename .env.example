# ---- Arc Testnet (public, safe to expose) ----
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Filled in after `npm run deploy:arc` in contracts/ (see README)
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_ESCROW_DEPLOY_BLOCK=

# ---- Auth.js (X / Twitter OAuth 2.0) ----
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ---- Server-only secrets (NEVER expose with NEXT_PUBLIC_) ----
# Operator wallet that releases escrow. Fund it with test USDC for gas.
OPERATOR_PRIVATE_KEY=
# Deployer wallet (contracts/ only; not needed by the Next app).
DEPLOYER_PRIVATE_KEY=
