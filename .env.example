# ---- Supabase (optional but needed on Vercel) ----
# Enables cloud storage for profile pictures (local disk does not persist on serverless).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional storage bucket name (created automatically if missing).
# SUPABASE_AVATAR_BUCKET=avatars

# ---- PostgreSQL (optional but recommended) ----
# Enables persisting users, payments and on-chain tx hashes. The app works
# without it (it reads the chain directly). Any Postgres works, e.g. Neon/Supabase.
# Apply schema with: npx prisma db push   (or  npx prisma migrate deploy)
DATABASE_URL=

# ---- Arc Mainnet (public, safe to expose) ----
NEXT_PUBLIC_ARC_RPC=https://rpc.mainnet.arc.io
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Filled in after `npm run deploy:arc` in contracts/ (see README)
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_ESCROW_DEPLOY_BLOCK=

# ---- Auth.js (X / Twitter OAuth 2.0) ----
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
# Public URL of the deployment (recommended in production, e.g. https://tuma.app)
# so callback URLs never depend on the request Host header.
AUTH_URL=

# ---- WalletConnect (optional) ----
# Enables the WalletConnect option (e.g. Zerion mobile). Get a project id at
# https://dashboard.reown.com. Leave blank to only offer injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Server-only secrets (NEVER expose with NEXT_PUBLIC_) ----
# Operator wallet that releases escrow. This is real USDC on mainnet: fund it with
# a small amount so it can pay gas for `release()`.
OPERATOR_PRIVATE_KEY=
# Deployer wallet (contracts/ only; not needed by the Next app).
DEPLOYER_PRIVATE_KEY=
# Protects POST /api/indexer (send as x-admin-secret or Authorization: Bearer).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=
