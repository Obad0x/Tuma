# Public values baked in at build time. Dashboard env vars with the same name
# take precedence over this file, so put secrets in Vercel and keep only safe
# defaults here. Redeploy after changing anything public.
NEXT_PUBLIC_ARC_RPC=https://rpc.mainnet.arc.io
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# WalletConnect / Reown project id. Enables the WalletConnect option (mobile
# wallets) via AppKit. Get one at https://dashboard.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=86f83c9d3b272f9ccf2a029ff4c1b410

# Filled in after `npm run deploy:arc` in contracts/ (see README), or set them
# in the host's dashboard:
# NEXT_PUBLIC_ESCROW_ADDRESS=
# NEXT_PUBLIC_ESCROW_DEPLOY_BLOCK=

# Optional: Google Search Console verification token (HTML tag method).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
