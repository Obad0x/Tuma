# Hardhat reads this when you run compile/test/deploy.
# Copy to contracts/.env and fill in.

# Wallet that deploys the contract (needs a little test USDC for gas).
DEPLOYER_PRIVATE_KEY=

# Wallet the server will use to call release(). Owner can change it later.
OPERATOR_ADDRESS=

# Optional overrides
ARC_RPC=https://rpc.testnet.arc.network
USDC_ADDRESS=0x3600000000000000000000000000000000000000
